/* Head Loss UI. Layout only; colours come from game.json (applied in code). Reference resolution 1920×1080.
   Every interactive element is at least 44 × 44 px (CLAUDE.md rule 13). */

.hl-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    font-size: 17px;
}

.hl-panel {
    border-radius: 8px;
    padding: 12px 14px;
    border-width: 1px;
}

.hl-title {
    font-size: 22px;
    -unity-font-style: bold;
    white-space: normal;
}

.hl-subtitle {
    font-size: 15px;
    opacity: 0.75;
    margin-top: 2px;
    white-space: normal;
}

.hl-section {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 4px;
    opacity: 0.7;
}

.hl-button {
    min-height: 44px;
    min-width: 44px;
    margin: 2px;
    padding: 0 12px;
    border-radius: 6px;
    border-width: 1px;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.hl-button--active {
    -unity-font-style: bold;
}

.hl-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.hl-dropdown {
    min-height: 44px;
    margin: 2px;
    font-size: 16px;
}

/* ---- building view: left ---- */

.hl-leftcolumn {
    position: absolute;
    left: 16px; top: 16px; bottom: 76px;
    width: 290px;
}

.hl-toolbox {
    margin-top: 10px;
}

.hl-crank {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
}

.hl-crank-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 0;
}

.hl-crank-label {
    font-size: 16px;
    -unity-text-align: middle-center;
}

.hl-heatmaps {
    position: absolute;
    left: 16px; bottom: 16px;
    flex-direction: row;
}

/* ---- building view: top centre ---- */

.hl-moneybar {
    position: absolute;
    top: 16px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
}

.hl-money {
    font-size: 24px;
    -unity-font-style: bold;
    margin: 0 12px;
}

.hl-money-debt {
    font-size: 17px;
    margin: 0 8px;
}

.hl-money-rate {
    font-size: 18px;
}

.hl-breakdown {
    position: absolute;
    top: 76px;
    left: 50%;
    translate: -50% 0;
    width: 320px;
}

.hl-designbar {
    position: absolute;
    top: 86px;
    left: 50%;
    translate: -50% 0;
    width: 760px;
    padding: 6px 12px;
    align-items: center;
}

.hl-design-text {
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.hl-design-reason {
    font-size: 15px;
    -unity-text-align: middle-center;
}

/* ---- building view: right ---- */

.hl-rightcolumn {
    position: absolute;
    right: 16px; top: 16px; bottom: 132px;
    width: 380px;
}

.hl-outlets {
    flex-shrink: 1;
}

.hl-outlet-row {
    min-height: 44px;
    padding: 4px 2px;
    margin-top: 2px;
}

.hl-zone-chip {
    width: 12px; height: 12px;
    border-radius: 6px;
    margin-right: 8px;
}

.hl-outlet-name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
}

.hl-outlet-value {
    font-size: 16px;
}

.hl-outlet-zone {
    font-size: 14px;
    margin-left: 20px;
}

.hl-gauge {
    height: 8px;
    margin: 4px 0 2px 20px;
    border-radius: 4px;
}

.hl-gauge-band {
    position: absolute;
    top: 0; bottom: 0;
}

.hl-gauge-mark {
    position: absolute;
    top: -3px; bottom: -3px;
    width: 2px;
}

.hl-gauge-dot {
    position: absolute;
    top: -3px;
    width: 14px; height: 14px;
    margin-left: -7px;
    border-radius: 7px;
}

.hl-readout {
    margin-top: 12px;
}

.hl-readout-line {
    font-size: 16px;
    margin-top: 3px;
    white-space: normal;
}

.hl-readout-title {
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
}

.hl-slider {
    min-height: 44px;
    min-width: 300px;
    font-size: 16px;
}

.hl-legend {
    position: absolute;
    right: 16px; bottom: 16px;
    width: 380px;
}

.hl-legend-bar {
    height: 18px;
    margin-top: 8px;
    border-radius: 3px;
}

.hl-legend-ticks {
    flex-direction: row;
    justify-content: space-between;
    font-size: 14px;
    margin-top: 2px;
}

/* ---- labels, hint, overlays ---- */

.hl-hint {
    position: absolute;
    bottom: 80px;
    left: 30%; right: 30%;
    -unity-text-align: middle-center;
    font-size: 17px;
    white-space: normal;
}

.hl-world-label {
    position: absolute;
    font-size: 14px;
    padding: 1px 6px;
    border-radius: 4px;
    border-width: 1px;
    -unity-text-align: middle-center;
}

.hl-sheet {
    position: absolute;
    left: 24%; right: 24%; top: 10%; bottom: 10%;
}

.hl-debug {
    position: absolute;
    left: 320px; top: 160px; right: 410px; bottom: 140px;
    font-size: 13px;
}

.hl-debug-text {
    white-space: nowrap;
    font-size: 13px;
}

.hl-debug-row {
    flex-direction: row;
}

.hl-debug-cell {
    font-size: 13px;
    -unity-text-align: middle-right;
    padding: 0 4px;
}

/* ---- menu and building list ---- */

.hl-menu {
    position: absolute;
    left: 50%; top: 22%;
    translate: -50% 0;
    width: 560px;
    padding: 28px;
}

.hl-menu-title {
    font-size: 44px;
    -unity-font-style: bold;
}

.hl-menu-button {
    margin-top: 10px;
    font-size: 19px;
}

.hl-buildings {
    position: absolute;
    left: 50%; top: 110px;
    translate: -50% 0;
    width: 760px;
    padding: 20px;
}

.hl-building-row {
    align-items: center;
    margin-top: 14px;
    padding-bottom: 8px;
}

.hl-slider .unity-base-slider__tracker {
    height: 8px;
    margin-top: -4px;
}

.hl-slider .unity-base-slider__dragger {
    width: 22px;
    height: 36px;
    margin-top: -18px;
    border-radius: 6px;
}

.hl-slider .unity-base-slider__drag-container {
    min-height: 44px;
}

/* ---- city view ---- */

.hl-citypanel {
    position: absolute;
    left: 16px; top: 16px;
    width: 360px;
}

.hl-plotpanel {
    position: absolute;
    right: 16px; top: 16px;
    width: 400px;
}

.hl-citymenu {
    position: absolute;
    left: 16px; bottom: 16px;
}

.hl-start-here {
    padding: 2px 8px;
    border-radius: 6px;
    -unity-font-style: bold;
}

/* ---- shop and notices ---- */

.hl-shop {
    position: absolute;
    left: 50%; top: 90px; bottom: 90px;
    translate: -50% 0;
    width: 900px;
    padding: 20px;
}

.hl-shop-list {
    flex-grow: 1;
    margin-top: 8px;
}

.hl-shop-row {
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(62, 74, 87, 0.12);
}

.hl-notice {
    position: absolute;
    top: 76px;
    left: 50%;
    translate: -50% 0;
    padding: 8px 16px;
}

.hl-away {
    position: absolute;
    left: 50%; top: 120px;
    translate: -50% 0;
    width: 560px;
    padding: 24px;
}
